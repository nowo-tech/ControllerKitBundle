{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Controller Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('homepage') }}">Controller Kit Bundle · Symfony 8.1</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            {% for item in [
                {route: 'homepage', label: 'Overview'},
                {route: 'demo_forward', label: 'SafeForwardTrait'},
                {route: 'demo_download_csv', label: 'CSV download'},
                {route: 'demo_download_json', label: 'JSON download'},
            ] %}
                <a class="nowo-ui-link" href="{{ path(item.route) }}"{% if app.request.attributes.get('_route') == item.route %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
