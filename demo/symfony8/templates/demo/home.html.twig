{% extends 'base.html.twig' %}

{% block title %}Controller Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), { title: 'Controller Kit Demo (Symfony 8)' }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <p><a class="nowo-ui-link" href="{{ path('demo_forward') }}">Test SafeForwardTrait</a></p>
            <p>DownloadResponseTrait: <a class="nowo-ui-link" href="{{ path('demo_download_csv') }}">formula-safe CSV</a> · <a class="nowo-ui-link" href="{{ path('demo_download_json') }}">JSON attachment (no-store)</a></p>
            {{ form_start(back_form) }}
                {% for child in back_form %}
                    {{ form_row(child) }}
                {% endfor %}
            {{ form_end(back_form) }}
        </div>
    </section>
{% endblock %}
